#bar-3577 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-3578 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-4424 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-4425 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-4426 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-4427 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-5250 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-5251 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-5252 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-5253" type="editorialComment ediromAnnotPrio2 wega.annotation.category.bogensetzung wega.annotation.category.dynamics">
                        <p xml:id="PDxxxN3l5l3l4l5l5l91l24l10">Das <rend xml:id="PDxxxN3l5l3l4l5l5l91l24l10l2" rend="italic">crescendo</rend> ist in den Quellen
                           unterschiedlich bezeichnet und beginnt in A bereits einen Takt früher.
                           Als Zielpunkt ist in A ein <rend xml:id="PDxxxN3l5l3l4l5l5l91l24l10l4" fontfam="euryanthe">F</rend> nur in der
                           Vla angegeben, d. h. hier soll offensichtlich die Dissonanz im Akkord
                           hervorgehoben werden. In K/sv ist <rend xml:id="PDxxxN3l5l3l4l5l5l91l24l10l6" fontfam="euryanthe">F</rend>
                           jedoch in Vl 2 und Cl nachgetragen. In T.48 hat Weber in Vl 1, Vl 2 die
                           Angaben des Kopisten überschrieben (vgl. Ebenen: Eintragungen). <lb xml:id="PDxxxN3l5l3l4l5l5l91l24l10l8"/> In
                           der Cl steht in A T. 48 ein Akzent auf der zweiten Note statt der in K/sv
                           von Weber zur ersten Note zugefügten <rend xml:id="PDxxxN3l5l3l4l5l5l91l24l10l10" rend="italic">descrescendo</rend>-Gabel.</p>
                     </annot>
