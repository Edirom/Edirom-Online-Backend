ource-5.xml#bar-1721027 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-5.xml#bar-1721028 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-5.xml#bar-1721029 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-5.xml#bar-1721853 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-5.xml#bar-1721854 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-5.xml#bar-1721855 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-5.xml#bar-1732274 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-5.xml#bar-1732275 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-5.xml#bar-1732276 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-5.xml#bar-17321099 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-5.xml#bar-17321100 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-5.xml#bar-17321101" type="editorialComment ediromAnnotPrio1 wega.annotation.category.correction wega.annotation.category.verbal-instruction">
                        <p xml:id="PDxxxN3l5l3l4l5l5l99l26l10">Der Kopist von K/sv hat den verbalen Zusatz als <rend xml:id="PDxxxN3l5l3l4l5l5l99l26l10l2" rend="italic">Pocco
                              più con moto</rend> wiedergegeben (vgl. auch A), Weber strich das
                              <rend xml:id="PDxxxN3l5l3l4l5l5l99l26l10l4" rend="italic">con</rend> aus. In ED₁ ist die Bezeichnung so nur
                           in die Vl 1 übernommen. In ED₂ ist sie in den übrigen Stimmen ergänzt,
                           wobei im Vc wieder die Form <rend xml:id="PDxxxN3l5l3l4l5l5l99l26l10l6" rend="italic">poco piu con moto</rend>
                           erscheint.</p>
                     </annot>
                     <annot xml:id="annotation-209" class="#ediromAnnotPrio1 #wega.annotation.category.bogensetzung" source="#source-1 #source-3 #source-2" staff="3 4 5" tstamp="1" tstamp2="2m+3" plist="xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-1.xml#bar-200273 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-1.xml#bar-200274 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-1.xml#bar-200275 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-3.xml#bar-2002722 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-3.xml#bar-2002723 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-3.xml#bar-2002724 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-3579 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-3580 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-3581 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-4428 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-4429 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-4430 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-5254 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-5255 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-5256" type="editorialComment ediromAnnotPrio1 wega.annotation.category.bogensetzung">
                        <p xml:id="PDxxxN3l5l3l4l5l5l99l28l10">Einerseits hat Weber hier in A großräumige Bögen zur Bezeichnung des
                              <rend xml:id="PDxxxN3l5l3l4l5l5l99l28l10l2" rend="italic">legato</rend> gesetzt, andererseits zusätzlich in
                           T.50 Vl 2 einen Artikulationsbogen. Der Kopist ist in seiner Übernahme
                           sehr freizügig verfahren. Auch der Stecher interpretierte die Anweisung
                           ungenau. Der Bogen im Vc endet in A am Taktstrich und in K/sv deutlich
                           nach dem Taktstrich zu T.52, in ED ist der Bogen auf zwei Takte verkürzt.
                           Vom Hg. ist die Bezeichnung hier trotz Parallelen zu T.4f. und T.16f.
                           nach der Hauptquelle übernommen.</p>
                     </annot>
                     <annot xml:id="annotation-208" class="#ediromAnnotPrio3 #wega.annotation.category.rhythm" source="#source-1 #source-3 #source-2" staff="2" tstamp="1" tstamp2="2m+3" plist="xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-1.xml#bar-200273 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-1.xml#bar-200274 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-1.xml#bar-200275 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-3.xml#bar-2002722 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-3.xml#bar-2002723 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-3.xml#bar-2002724 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-1828 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-1829 xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-2.xml#bar-1830" type="editorialComment ediromAnnotPrio3 wega.annotation.category.rhythm">
                        <p xml:id="PDxxxN3l5l3l4l5l5l99l30l10">In Vl 1 steht in ED in T.49 am Taktende keine Punktierung.</p>
                     </annot>
