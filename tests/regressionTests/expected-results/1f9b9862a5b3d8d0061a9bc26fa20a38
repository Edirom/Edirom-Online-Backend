                     <annot xml:id="annotation-23" class="#ediromAnnotPrio3 #wega.annotation.category.correction" source="#source-1" staff="2" tstamp="1" tstamp2="0m+5" plist="xmldb:exist:///db/apps/weber-klarinettenquintett-eol-emeritus/sources/source-1.xml#bar-20029" type="editorialComment ediromAnnotPrio3 wega.annotation.category.correction">
                        <p xml:id="PDxxxN3l5l3l2l5l5l59l26l10">Die Viertelnote mit angebundener 16tel war ursprünglich <rend xml:id="PDxxxN3l5l3l2l5l5l59l26l10l2" rend="italic">ces</rend>
                           <rend xml:id="PDxxxN3l5l3l2l5l5l59l26l10l4" rend="sup">
                              <rend xml:id="PDxxxN3l5l3l2l5l5l59l26l10l4l3" fontsize="small">1</rend>
                           </rend>, wurde aber durch eine zusätzliche Hilfslinie zu <rend xml:id="PDxxxN3l5l3l2l5l5l59l26l10l6" rend="italic">as</rend> korrigiert.</p>
